# ====================================================================
# ClipA Studio - Vercel Environment Variables
# ====================================================================

# Google Gemini API Key (Serverless Function Route)
GEMINI_API_KEY=your_gemini_api_key_here

# Turso (libSQL) Database Connection
# Buat database di https://turso.tech/ dengan perintah:
#   turso db create clipa-studio
#   turso db show clipa-studio --url
#   turso db tokens create clipa-studio
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
